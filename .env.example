# PostgreSQL
# Copy this file to .env and replace the placeholder values with your own.
POSTGRES_USER=student_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=student_management
POSTGRES_PORT=5432
DATABASE_URL="postgresql://student_app:change_me@localhost:5432/student_management?schema=public"

# Application
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
CORS_ORIGINS=
