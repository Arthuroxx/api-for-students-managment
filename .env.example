# PostgreSQL
# Copy this file to .env and replace the placeholder values with your own.
POSTGRES_USER=student_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=student_management
POSTGRES_PORT=5432
# Used when running the API on the host (npm run start:dev).
# Docker Compose builds its own internal URL that points to the `postgres` service.
DATABASE_URL="postgresql://student_app:change_me@localhost:5432/student_management?schema=public"

# Optional isolated database used by the e2e suite.
# Defaults to DATABASE_URL with `_test` appended to the database name.
# TEST_DATABASE_URL="postgresql://student_app:change_me@localhost:5432/student_management_test?schema=public"

# Application
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
CORS_ORIGINS=

# Authentication
# Use a random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Access token lifetime in seconds (between 60 and 604800).
JWT_EXPIRES_IN_SECONDS=3600

# Initial ADMIN user created by `npm run db:seed`
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change_me
