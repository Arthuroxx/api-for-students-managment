# Optional isolated database for the e2e test suite.
# When omitted, the test database is derived from DATABASE_URL by appending
# `_test` to its database name (for example, student_management_test).
# The suite recreates and migrates this database on every run.
# TEST_DATABASE_URL=postgresql://student_app:change_me@localhost:5432/student_management_test?schema=public

# Test-only authentication configuration.
JWT_SECRET=test-only-jwt-secret-with-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600
