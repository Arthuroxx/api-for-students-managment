// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id             String   @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  email          String   @unique
  documentNumber String   @unique
  birthDate      DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Matches the default listing order: newest first, with id as a stable tie-breaker.
  @@index([createdAt(sort: Desc), id], map: "students_createdAt_id_idx")
  // Trigram indexes accelerate the case-insensitive partial filters (ILIKE '%term%').
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_lastName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_email_trgm_idx")
  @@map("students")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
